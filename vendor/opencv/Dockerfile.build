# Recipe for the prebuilt FFmpeg-free OpenCV wheel in this directory (see MANIFEST.md).
# Not part of the production image build: that installs the wheel committed here.
# To rebuild after an OpenCV bump, set OPENCV_VERSION and OPENCV_SDIST_SHA256 to the new
# release (they must match uv.lock), then:
#   podman build -f vendor/opencv/Dockerfile.build -t vista-opencv-wheel vendor/opencv
#   cid=$(podman create vista-opencv-wheel) && podman cp "$cid":/wheels/. vendor/opencv/ && podman rm "$cid"
# and refresh SHA256SUMS and requirements-opencv-prebuilt.txt from the new wheel.
# OpenCV without FFmpeg. The opencv-python-headless wheels on PyPI bundle FFmpeg
# libraries that accumulate unpatched CVEs, and VISTA never decodes video with
# cv2, so build the headless wheel from the hash-pinned PyPI source distribution
# with FFmpeg disabled. Video writing and decoding through cv2 is unavailable in
# this image by design. Keep OPENCV_VERSION equal to the opencv-python-headless
# version in uv.lock; backend/tests/test_container_build_config.py enforces it.
# A cold build compiles OpenCV and takes a while.
FROM registry.access.redhat.com/ubi9/ubi-minimal AS opencv-build

ARG OPENCV_VERSION=5.0.0.93
# Compile jobs: about one per 2 GiB of memory. nproc would use every core.
ARG OPENCV_JOBS=8
ARG OPENCV_SDIST_SHA256=b82f9831daab90b725c7c1ee1b36cb5732c367096ac76d119e64e14eb70d5f3c

# gcc-toolset-13 is required: the default UBI 9 assembler is too old for
# instructions that OpenCV's dnn module emits.
RUN microdnf install -y --nodocs \
    python3.11 \
    python3.11-pip \
    python3.11-devel \
    gcc-toolset-13-gcc \
    gcc-toolset-13-gcc-c++ \
    gcc-toolset-13-binutils \
    make \
    cmake \
    && microdnf clean all

ENV PATH="/opt/rh/gcc-toolset-13/root/usr/bin:$PATH"
ENV ENABLE_HEADLESS=1
ENV CMAKE_ARGS="-DWITH_FFMPEG=OFF"

# The optional extra_ca build secret (a proxy CA on networks that inspect TLS; see
# scripts/build_image.sh) is combined with the system bundle in a tmpfs, so it never
# lands in a layer. TLS verification is never disabled.
RUN --mount=type=secret,id=extra_ca --mount=type=tmpfs,target=/run/ca \
    if [ -s /run/secrets/extra_ca ]; then \
      cat /etc/pki/tls/certs/ca-bundle.crt /run/secrets/extra_ca > /run/ca/bundle.pem && \
      export PIP_CERT=/run/ca/bundle.pem SSL_CERT_FILE=/run/ca/bundle.pem; \
    fi && \
    echo "opencv-python-headless==${OPENCV_VERSION} --hash=sha256:${OPENCV_SDIST_SHA256}" \
        > /tmp/opencv-requirements.txt && \
    CMAKE_BUILD_PARALLEL_LEVEL="${OPENCV_JOBS}" python3.11 -m pip wheel \
        --no-deps --no-binary opencv-python-headless --require-hashes \
        -r /tmp/opencv-requirements.txt -w /wheels

# The module is built against the limited API (cv2/cv2.abi3.so) but scikit-build tags the
# wheel cp311-cp311. Retag it cp311-abi3 so it installs on Python 3.11 and every later
# version (the production image runs 3.14). Only WHEEL and RECORD change.
RUN --mount=type=secret,id=extra_ca --mount=type=tmpfs,target=/run/ca \
    if [ -s /run/secrets/extra_ca ]; then \
      cat /etc/pki/tls/certs/ca-bundle.crt /run/secrets/extra_ca > /run/ca/bundle.pem && \
      export PIP_CERT=/run/ca/bundle.pem; \
    fi && \
    python3.11 -m pip install --no-cache-dir wheel==0.45.1 && \
    python3.11 -m wheel tags --python-tag cp311 --abi-tag abi3 \
        --platform-tag linux_x86_64 --remove /wheels/opencv_python_headless-*.whl && \
    ls /wheels/opencv_python_headless-*-cp311-abi3-linux_x86_64.whl
