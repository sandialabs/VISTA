{
  "name": "vista-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "flexlayout-react": "^0.8.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "^5.0.1",
    "three": "^0.185.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "node scripts/start-react-dev.js",
    "dev:fast": "node scripts/start-react-dev.js --fast",
    "build": "react-scripts build",
    "build:analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "build:profile": "react-scripts --profile build",
    "test": "react-scripts test --runInBand --watchAll=false --all",
    "test:e2e": "playwright test --project=chromium-local",
    "test:e2e:browsers": "playwright test --config=playwright.cross-browser.config.js",
    "test:e2e:install-browsers": "node scripts/install-cross-browser-browsers.js",
    "test:e2e:pr03": "playwright test e2e/specs/inspection-workbench.spec.js",
    "test:e2e:headed": "playwright test --headed --project=chromium-local",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx --ignore-pattern '**/__tests__/**' --ignore-pattern '**/*.test.js' --ignore-pattern src/setupTests.js --max-warnings 0",
    "test:unit:ci": "CI=true react-scripts test --runInBand --watchAll=false --silent --reporters=./scripts/compact-jest-reporter.js",
    "test:ci": "npm run test:unit:ci && npm run test:e2e"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "http-proxy-middleware": "^2.0.9",
    "playwright": "^1.59.1",
    "react-app-rewired": "^2.2.1",
    "typescript": "^4.9.5",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "overrides": {
    "nth-check": ">=2.0.1",
    "postcss": ">=8.4.31",
    "cross-spawn": ">=6.0.6",
    "node-forge": ">=1.3.2"
  }
}
