{
  "name": "vista-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "flexlayout-react": "^0.8.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "three": "^0.185.1"
  },
  "scripts": {
    "start": "vite",
    "dev": "node scripts/start-react-dev.js",
    "dev:fast": "node scripts/start-react-dev.js --fast",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --runInBand --watchAll=false",
    "test:e2e": "playwright test --project=chromium-local",
    "test:e2e:browsers": "playwright test --config=playwright.cross-browser.config.js",
    "test:e2e:install-browsers": "node scripts/install-cross-browser-browsers.js",
    "test:e2e:pr03": "playwright test e2e/specs/inspection-workbench.spec.js",
    "test:e2e:headed": "playwright test --headed --project=chromium-local",
    "lint": "eslint src --max-warnings 0",
    "test:unit:ci": "CI=true jest --runInBand --watchAll=false --silent --reporters=./scripts/compact-jest-reporter.js",
    "test:ci": "npm run test:unit:ci && npm run test:e2e"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "6.1.2",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "playwright": "^1.59.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "postcss": ">=8.4.31",
    "cross-spawn": ">=6.0.6",
    "glob": "14.0.2",
    "minimatch@>=7": "11.0.1"
  }
}
