# Development Dockerfile for VISTA (RHEL/UBI9 Minimal based)
# Single image with Python 3.14 and Node.js for full-stack development

FROM registry.access.redhat.com/ubi9/ubi-minimal AS base

# Optional extra CA certificates for networks with TLS inspection (corporate
# proxies such as Zscaler). scripts/dev.sh stages host CAs into certs/; the
# directory is empty by default, in which case only the stock bundle is used.
# Never replace this with --trusted-host / --insecure / strict-ssl=false.
COPY certs/ /tmp/extra-ca/
RUN find /tmp/extra-ca -type f \( -name '*.crt' -o -name '*.pem' \) \
        -exec cp {} /etc/pki/ca-trust/source/anchors/ \; && \
    update-ca-trust extract && \
    rm -rf /tmp/extra-ca
# Point every HTTPS client at the system bundle. uv ships its own root store
# unless native TLS is enabled; Node/npm only honor NODE_EXTRA_CA_CERTS.
ENV SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt \
    REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt \
    PIP_CERT=/etc/pki/tls/certs/ca-bundle.crt \
    UV_NATIVE_TLS=true \
    NODE_EXTRA_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt

# Install Node.js 22 and system dependencies. The UBI default nodejs stream is Node 16;
# the UI tooling (Vite 8, react-router 7) needs Node 20.19 or newer. Python is not an RPM:
# RHEL 9 has no 3.14, so the same python-build-standalone build as the production image is
# installed below.
RUN microdnf module enable -y nodejs:22 && \
    microdnf install -y --nodocs \
    tar \
    gzip \
    gcc \
    gcc-c++ \
    libpq-devel \
    git \
    wget \
    ca-certificates \
    nodejs \
    npm \
    atk \
    at-spi2-atk \
    alsa-lib \
    cups-libs \
    gtk3 \
    libX11-xcb \
    libXcomposite \
    libXcursor \
    libXdamage \
    libXext \
    libXfixes \
    libXi \
    libXrandr \
    libXScrnSaver \
    libXtst \
    libdrm \
    libgbm \
    libxcb \
    pango \
    shadow-utils \
    && microdnf clean all
# CPython 3.14 from python-build-standalone: the same pinned build as the production
# Dockerfile (keep the three ARGs identical; test_container_python_runtime_config.py checks).
# It is fetched after the CA trust step above, so it works behind TLS inspection. Unlike
# production, pip and the headers stay, for development tools and source builds. Its
# sysconfig names clang, so point extension builds at the installed gcc.
ARG PBS_RELEASE=20261110
ARG PBS_PYTHON=3.14.10
ARG PBS_SHA256=c2ff2e97422f5d3896a16e0317fd212ba977bbf2688d93a6f7a03d817506bd30
RUN curl -fsSL -o /tmp/python.tar.gz \
        "https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_RELEASE}/cpython-${PBS_PYTHON}%2B${PBS_RELEASE}-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz" && \
    echo "${PBS_SHA256}  /tmp/python.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/python.tar.gz -C /opt && rm /tmp/python.tar.gz && \
    ln -sf /opt/python/bin/python3.14 /usr/bin/python3 && \
    ln -sf /opt/python/bin/python3.14 /usr/bin/python
ENV CC=gcc CXX=g++

# Create appuser
RUN useradd -m -s /bin/bash appuser

# Create virtual environment
RUN python -m venv /opt/venv && chown -R appuser:appuser /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install uv and debugging tools
RUN pip install --no-cache-dir --upgrade pip uv
RUN pip install --no-cache-dir ultralytics

WORKDIR /app

# Install Python dependencies (cached layer)
COPY pyproject.toml uv.lock ./
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN uv sync --frozen --no-install-project --inexact

# Copy backend code (will be overridden by volume mount in development)
COPY ./backend /app/backend
# Download the bundled default SAM checkpoint used by Analyze (public weights
# only; nothing is committed to the repository). See Dockerfile for details.
RUN mkdir -p /app/checkpoints && \
    wget -q -O /app/checkpoints/sam_vit_b_01ec64.pth \
        https://dl.fbaipublicfiles.com/segment_anything/sam_vit_b_01ec64.pth

# Backend tests validate frontend npm scripts, so keep package metadata
# available in the backend-dev image even when only /app/backend is mounted.
COPY ./frontend/package.json ./frontend/package-lock.json /app/frontend/

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV no_proxy=$no_proxy,minio
ENV NO_PROXY=$no_proxy

# Shared backend runtime stage
FROM base AS backend-runtime
ENV VISTA_DISABLE_NATIVE_SEGMENTATION_RUNTIME=false
ENV YOLO_CONFIG_DIR=/tmp/ultralytics
# Restricted YOLO checkpoint loading, as in the production image.
ENV ULTRALYTICS_SAFE_LOAD=1
RUN chown -R appuser:appuser /app
WORKDIR /app/backend
EXPOSE 8000

USER appuser

# Backend development stage
FROM backend-runtime AS backend-dev

COPY --chown=appuser:appuser ./test /app/test

# The dependency manifests are bind-mounted by docker-compose.dev.yml. Reconcile the
# environment on every start so an existing development image picks up newly added
# packages without requiring developers to diagnose import errors and rebuild first.
CMD ["sh", "-c", "uv sync --frozen --no-install-project --inexact && exec uvicorn main:app --host 0.0.0.0 --port 8000 --reload"]

# Optional heavyweight model service for Analyze/backend analyze toolbox execution.
FROM backend-runtime AS toolbox-model-service

# The locked torch is already the CUDA build (cu130 wheels from PyPI), so SAM, YOLO and
# Anomalib use the GPU that docker-compose.dev.yml passes in as a CDI device; only the extra
# model-hub libraries are added here. Reinstalling torch from another index would mismatch
# the locked torchvision.
USER root
RUN pip install --no-cache-dir \
    transformers \
    accelerate \
    huggingface_hub

USER appuser
WORKDIR /app
EXPOSE 8010

CMD ["uvicorn", "backend.analyze_toolbox.model_service:app", "--host", "0.0.0.0", "--port", "8010"]

# Frontend development stage
FROM base AS frontend-dev

WORKDIR /app/frontend

# Copy package files first (for caching)
RUN chown appuser:appuser /app/frontend
COPY --chown=appuser:appuser frontend/package*.json ./

# Install dependencies and set ownership
RUN npm ci --no-audit --no-fund && chown -R appuser:appuser /app

# Copy frontend source (will be overridden by volume mount in development)
COPY --chown=appuser:appuser frontend/ ./

EXPOSE 3000

CMD ["npm", "run", "dev"]
