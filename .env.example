# NETWORKING CONFIGURATION
# For local development (app runs on host):
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/postgres
#   S3_ENDPOINT=localhost:9000
#
# For Docker development (app runs in container):
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres
#   S3_ENDPOINT=minio:9000
#
# The values below are for local development. Docker setup uses docker-compose.dev.yml environment overrides.

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433

# Host Port Overrides (change if you have port conflicts)
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# PGADMIN_PORT=8080

# S3/MinIO Configuration
S3_ENDPOINT=localhost:9000
# Leave both empty (or either one) to use boto3's default credential chain
# (EKS Pod Identity, IRSA, instance role) instead of static keys.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=data-storage
S3_NAMESPACE=
S3_USE_SSL=false
S3_REGION=us-east-1
MAX_S3_LIST_SCAN_KEYS=50000

# Application Configuration
APP_NAME="Data Management API"
GITLAB_COMMIT_SHA=
DEBUG=false
PORT=8000
FAST_TEST_MODE=false
SKIP_HEADER_CHECK=false
CHECK_MOCK_MEMBERSHIP=true
MOCK_USER_EMAIL=test@example.com
MOCK_USER_GROUPS_JSON='["admin-group", "data-scientists", "project-alpha-group", "testgroup"]'

# Migration Retry Configuration
MIGRATION_RETRY_ATTEMPTS=15
MIGRATION_RETRY_DELAY_SECONDS=2.0

# Deployment Environment: development | staging | production
# When set to "production", the app refuses to start with DEBUG=true,
# SKIP_HEADER_CHECK=true, VISTA_AUTH_BACKEND=demo, or a missing
# PROXY_SHARED_SECRET.
ENV=development

# Group Authorization Backend (REQUIRED -- fail-closed by default)
#   demo   -- hardcoded example mapping in core.group_auth. Development
#             and automated tests only; refused when ENV=production.
#   custom -- membership comes from the groups the authenticating proxy
#             asserts in X_USER_GROUPS_HEADER on each proxied request (see
#             core/group_snapshot.py and docs/production/proxy-setup.md). It
#             requires PROXY_SHARED_SECRET (the app refuses to start without
#             it unless DEBUG or SKIP_HEADER_CHECK is on). Startup self-test
#             denies the demo emails.
# If unset or set to any other value, the app refuses to start.
VISTA_AUTH_BACKEND=demo

# Proxy-asserted groups (VISTA_AUTH_BACKEND=custom only)
# Header the proxy puts the user's groups in, comma separated (oauth2-proxy
# sends X-Forwarded-Groups). Read only on requests whose X-Proxy-Secret matched.
X_USER_GROUPS_HEADER=X-Forwarded-Groups
# A user's last proxy-asserted groups also apply to requests that carry no proxy
# headers and no groups of their own (the MCP server, API keys made before
# per-key groups), for this many seconds (default 7 days). Every proxied request
# renews them. A new API key instead stores its creator's groups when it is made,
# with no expiry. Requires the user_group_snapshots table and api_keys.groups
# (alembic upgrade head).
GROUPS_SNAPSHOT_TTL_SECONDS=604800
# How often each process reloads the table, to see other replicas' assertions.
GROUPS_SNAPSHOT_REFRESH_SECONDS=60

# Security Configuration
SECURITY_NOSNIFF_ENABLED=true
SECURITY_XFO_ENABLED=true
SECURITY_XFO_VALUE=SAMEORIGIN
SECURITY_REFERRER_POLICY_ENABLED=true
SECURITY_REFERRER_POLICY_VALUE=no-referrer
SECURITY_CSP_ENABLED=true

# Cache Configuration
CACHE_SIZE_MB=1000
CACHE_DIR=
VOLUME_CACHE_DIR=
VOLUME_CACHE_MAX_BYTES=10737418240
VOLUME_MEMMAP_CACHE_ITEMS=8

# Image Upload And Import Limits
MAX_UPLOAD_BYTES=2684354560
MAX_BATCH_UPLOAD_FILES=100
MAX_BATCH_UPLOAD_BYTES=268435456
MAX_BATCH_UPLOAD_MANIFEST_BYTES=8388608
MAX_BATCH_UPLOAD_CONCURRENCY=6
MAX_BATCH_METADATA_BYTES=1048576
MAX_BATCH_METADATA_DEPTH=32
MAX_BATCH_METADATA_ITEMS=10000
MAX_BATCH_METADATA_STRING_BYTES=1048576
MAX_BATCH_METADATA_KEY_BYTES=4096
MAX_S3_LIST_KEYS=5000
MAX_S3_IMPORT_CONCURRENCY=6

# Native Segmentation Runtime
VISTA_DISABLE_NATIVE_SEGMENTATION_RUNTIME=false

# Frontend Configuration
FRONTEND_BUILD_PATH=frontend/build
DISABLE_FILE_LOGGING=false
CORS_ORIGINS=http://localhost:3000

# MCP Server Configuration
# Required before running backend/mcp_server.py. Use a unique secret value.
VISTA_MCP_API_KEY=
MCP_HOST=localhost
MCP_PORT=8001
VISTA_MODEL_SERVICE_DEVICE=auto
